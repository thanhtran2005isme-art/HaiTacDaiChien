      - Max level is 100
      - เลเวลสูงสุด100
      - 最大等級100級
      Flags: 00000000
      Languages_Touch: []
    - Term: MSG_POPUP_HERO_INFO_MAX_LEVEL
      TermType: 0
      Languages:
